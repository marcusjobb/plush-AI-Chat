# Kopiera till .env och fyll i din egen nyckel från https://1min.ai
ONEMIN_API_KEY=din-nyckel-här
# Valfri: andra OpenAI-kompatibla endpoints
# ONEMIN_BASE_URL=https://api.1min.ai/openai/v1

# Assistenternas namn och modeller. Välj billiga modeller.
ASSISTANT_1_NAME=Ada
ASSISTANT_1_MODEL=gpt-4o-mini
ASSISTANT_2_NAME=Bo
ASSISTANT_2_MODEL=deepseek-v4-pro
ASSISTANT_3_NAME=Kalle
ASSISTANT_3_MODEL=qwen3.7-max
ASSISTANT_4_NAME=Margareta
ASSISTANT_4_MODEL=glm-5.3
