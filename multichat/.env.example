# Välj leverantör: 1min (standard), openai, anthropic, openrouter eller custom.
# Varje leverantör har sin egen nyckelvariabel. Fyll bara i den du använder.
PROVIDER=1min

ONEMIN_API_KEY=din-nyckel-här
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# custom: egen OpenAI-kompatibel endpoint
# CUSTOM_BASE_URL=https://din-endpoint/v1
# CUSTOM_API_KEY=

# Assistenternas namn och modeller. Modellnamnen måste passa vald leverantör.
ASSISTANT_1_NAME=Ada
ASSISTANT_1_MODEL=gpt-4o-mini
ASSISTANT_2_NAME=Bo
ASSISTANT_2_MODEL=deepseek-v4-pro
ASSISTANT_3_NAME=Kalle
ASSISTANT_3_MODEL=qwen3.7-max
ASSISTANT_4_NAME=Margareta
ASSISTANT_4_MODEL=glm-5.3
