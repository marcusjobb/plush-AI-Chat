# Välj leverantör: 1min (standard), openai, anthropic, openrouter eller custom.
# Varje leverantör har sin egen nyckelvariabel. Fyll bara i den du använder.
PROVIDER=1min

ONEMIN_API_KEY=din-nyckel-här
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# custom: egen OpenAI-kompatibel endpoint
# CUSTOM_BASE_URL=https://din-endpoint/v1
# CUSTOM_API_KEY=

# Kopiera till .env och fyll i din egen nyckel från
# https://1min.ai/?referrer_id=9b12faba-f8a3-49ea-bd25-d8343f1fd965
# (värvningslänk: ni får båda extra tokens, och 15 000 tokens delas ut varje dag
# till den som loggar in)
ONEMIN_MODEL=gpt-4o-mini

# /compact körs med en starkare modell: på samma historik behöll gpt-4o-mini
# 2 av 5 detaljer (kattfärg, åsikt, yrke, musik, låtar) medan gpt-4o behöll 5 av 5.
# Ta bort raden om din plan inte har gpt-4o — då används ONEMIN_MODEL.
ONEMIN_COMPACT_MODEL=gpt-4o

# Personlighet: Margareta. Sätt ONEMIN_PERSONA=0 för att stänga av.
# ONEMIN_PERSONA=1

# Automatisk komprimering när historiken når så här många meddelanden (0 = av).
# Standard är 50. ONEMIN_AUTO_COMPACT=50
